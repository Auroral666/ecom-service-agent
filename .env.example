# OpenAI API Key
OPENAI_API_KEY=your_api_key_here

# API 代理地址（可选，默认为 OpenAI 官方地址）
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型配置
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7

# MCP 配置
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# Multi-Agent 配置
MULTI_AGENT_ENABLED=false

# Memory 配置
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# Skill 配置
SKILLS_ENABLED=true
SKILLS_DIR=app/skills

# Evaluation 配置（离线评估工具）
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# RAG 配置
EMBEDDING_MODEL=text-embedding-3-small
KB_DIR=app/knowledge
# 向量后端：numpy（余弦相似度，JSON 持久化）/ chroma（向量数据库，生产代表）
RAG_BACKEND=numpy
# NumpyBackend 索引文件
KB_INDEX_PATH=app/sessions/kb_index.json
# ChromaBackend 持久化目录 + collection
CHROMA_PERSIST_DIR=app/sessions/chroma
CHROMA_COLLECTION=ecom_kb

# 可选：独立 Embedding 服务；不设置时沿用聊天服务。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Jina 本地服务开启 query/passage 任务区分；普通 API 保持 false。
EMBEDDING_TASK_AWARE=false
